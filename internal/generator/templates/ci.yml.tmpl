name: CI/CD Pipeline

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  validate:
    name: Validate Compose
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Validate docker compose configuration
        run: docker compose config

  security-scan:
    name: Security Scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@0.32.0
        with:
          scan-type: "fs"
          scan-ref: "."
          severity: "CRITICAL,HIGH"
          exit-code: "1"

  build-and-test:
    name: Build and Test
    runs-on: ubuntu-latest
    needs: [validate, security-scan]
    steps:
      - uses: actions/checkout@v4

      - name: Start services
        run: docker compose up -d

      - name: Wait for healthy services
        run: |
          echo "Waiting for services..."
          for i in $(seq 1 30); do
            if docker compose ps --format json | jq -e 'select(.Health == "starting")' > /dev/null 2>&1; then
              echo "Attempt $i/30: services still starting..."
              sleep 5
            else
              echo "All services ready."
              break
            fi
          done
          docker compose ps

{{- if .HasBackend }}
      - name: Verify API response
        run: |
          API_PORT=$(docker compose port api {{ .BackendPort }} | awk -F: '{print $NF}' | head -n 1)
          STATUS=$(curl -sf -o /dev/null -w "%%{http_code}" "http://localhost:${API_PORT}/health" || echo "000")
          echo "Health check response: $STATUS"
          test "$STATUS" = "200"
{{- else if .HasFrontend }}
      - name: Verify frontend response
        run: |
          FRONTEND_PORT=$(docker compose port frontend {{ .FrontendPort }} | awk -F: '{print $NF}' | head -n 1)
          STATUS=$(curl -sf -o /dev/null -w "%%{http_code}" "http://localhost:${FRONTEND_PORT}/" || echo "000")
          echo "Frontend response: $STATUS"
          test "$STATUS" = "200"
{{- else }}
      - name: Verify compose project
        run: docker compose ps
{{- end }}

      - name: Tear down
        if: always()
        run: docker compose down -v
