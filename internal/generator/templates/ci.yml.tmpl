name: CI/CD Pipeline

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  validate:
    name: Validate Compose
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - name: Prepare environment file
        run: |
          if [ -f .env.example ] && [ ! -f .env ]; then
            cp .env.example .env
          fi
      - name: Validate docker compose configuration
        run: docker compose config

  security-scan:
    name: Security Scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      # Install Trivy from its GitHub release and verify the checksum, outside the
      # workspace so the scan does not pick up the downloaded archive.
      - name: Install Trivy
        env:
          TRIVY_VERSION: "{{ .TrivyVersion }}"
        run: |
          archive="trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz"
          base="https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}"
          install_dir="${RUNNER_TEMP}/trivy-bin"
          mkdir -p "${install_dir}"
          cd "${RUNNER_TEMP}"
          curl -fsSLO "${base}/${archive}"
          curl -fsSLO "${base}/trivy_${TRIVY_VERSION}_checksums.txt"
          grep " ${archive}\$" "trivy_${TRIVY_VERSION}_checksums.txt" | sha256sum -c -
          tar -xzf "${archive}" -C "${install_dir}" trivy
          echo "${install_dir}" >> "${GITHUB_PATH}"
      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@v0.36.0
        with:
          skip-setup-trivy: true
          scan-type: "fs"
          scan-ref: "."
          severity: "CRITICAL,HIGH"
          exit-code: "1"

  build-and-test:
    name: Build and Test
    runs-on: ubuntu-latest
    needs: [validate, security-scan]
    steps:
      - uses: actions/checkout@v6
      - name: Prepare environment file
        run: |
          if [ -f .env.example ] && [ ! -f .env ]; then
            cp .env.example .env
          fi

      - name: Start services
        run: docker compose up -d

      - name: Wait for healthy services
        run: |
          echo "Waiting for services..."
          ready=false
          for i in $(seq 1 30); do
            if docker compose ps --format json | jq -s -e 'length > 0 and all(.[]; .State == "running" and (.Health == "" or .Health == "healthy"))' > /dev/null; then
              echo "All services ready."
              ready=true
              break
            fi
            echo "Attempt $i/30: services are not ready..."
            sleep 5
          done
          docker compose ps
          if [ "$ready" != "true" ]; then
            docker compose logs
            exit 1
          fi

{{- if .HasBackend }}
      - name: Verify API response
        run: |
          API_PORT=$(docker compose port api {{ .BackendPort }} | awk -F: '{print $NF}' | head -n 1)
          for i in $(seq 1 30); do
            STATUS=$(curl -sf -o /dev/null -w "%{http_code}" "http://localhost:${API_PORT}/health" || echo "000")
            echo "API health check attempt $i/30: $STATUS"
            if [ "$STATUS" = "200" ]; then
              exit 0
            fi
            sleep 5
          done
          docker compose logs api
          exit 1
{{- else if .HasFrontend }}
      - name: Verify frontend response
        run: |
          FRONTEND_PORT=$(docker compose port frontend {{ .FrontendPort }} | awk -F: '{print $NF}' | head -n 1)
          for i in $(seq 1 30); do
            STATUS=$(curl -sf -o /dev/null -w "%{http_code}" "http://localhost:${FRONTEND_PORT}/" || echo "000")
            echo "Frontend check attempt $i/30: $STATUS"
            if [ "$STATUS" = "200" ]; then
              exit 0
            fi
            sleep 5
          done
          docker compose logs frontend
          exit 1
{{- else }}
      - name: Verify compose project
        run: docker compose ps
{{- end }}

      - name: Tear down
        if: always()
        run: docker compose down -v
