FROM php:{{ .VersionPHP }}
RUN sed -ri 's!Listen 80!Listen 8080!' /etc/apache2/ports.conf \
    && sed -ri 's!<VirtualHost \*:80>!<VirtualHost *:8080>!' /etc/apache2/sites-available/000-default.conf \
    && printf '%s\n' 'ServerName localhost' '<Directory /var/www/html>' '    FallbackResource /index.php' '</Directory>' > /etc/apache2/conf-available/dev-box.conf \
    && a2enconf dev-box
COPY --chown=www-data:www-data . /var/www/html/
USER www-data
EXPOSE 8080
