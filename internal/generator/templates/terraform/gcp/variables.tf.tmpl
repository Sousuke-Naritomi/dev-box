variable "project_id" {
  description = "GCP project ID"
  type        = string
}

variable "region" {
  description = "GCP region"
  type        = string
  default     = "asia-northeast1"
}

variable "zone" {
  description = "GCP zone"
  type        = string
  default     = "asia-northeast1-a"
}

variable "name_prefix" {
  description = "Prefix for resource names and network tags; change it to run several environments side by side"
  type        = string
  default     = "devbox"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{1,20}$", var.name_prefix))
    error_message = "name_prefix must start with a lowercase letter and contain only lowercase letters, digits and hyphens (2-21 characters)."
  }
}

variable "machine_type" {
  description = "Compute Engine machine type, sized for the selected stack"
  type        = string
  default     = "{{ .InstanceType }}"
}

variable "enable_public_ip" {
  description = "Whether to allocate an external IPv4 address"
  type        = bool
  default     = false
}

variable "allowed_ssh_cidrs" {
  description = "CIDR blocks allowed to connect over SSH; empty disables public SSH"
  type        = list(string)
  default     = []
}

variable "enable_public_web" {
  description = "Whether to expose HTTP and HTTPS publicly"
  type        = bool
  default     = false
}

variable "allowed_web_cidrs" {
  description = "CIDR blocks allowed to access HTTP and HTTPS"
  type        = list(string)
  default     = []
}
