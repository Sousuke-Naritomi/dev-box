variable "location" {
  description = "Azure region"
  type        = string
  default     = "japaneast"
}

variable "name_prefix" {
  description = "Prefix for resource names; change it to run several environments side by side"
  type        = string
  default     = "devbox"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{1,20}$", var.name_prefix))
    error_message = "name_prefix must start with a lowercase letter and contain only lowercase letters, digits and hyphens (2-21 characters)."
  }
}

variable "vm_size" {
  description = "Azure VM size, sized for the selected stack"
  type        = string
  default     = "{{ .InstanceType }}"
}

variable "admin_username" {
  description = "Admin username for the VM"
  type        = string
  default     = "azureuser"
}

variable "ssh_public_key" {
  description = "OpenSSH public key used to access the VM"
  type        = string
}

variable "allowed_ssh_cidrs" {
  description = "CIDR blocks allowed to connect over SSH; empty disables public SSH"
  type        = list(string)
  default     = []
}

variable "enable_public_web" {
  description = "Whether to expose HTTP publicly"
  type        = bool
  default     = false
}

variable "allowed_web_cidrs" {
  description = "CIDR blocks allowed to access HTTP"
  type        = list(string)
  default     = []
}
