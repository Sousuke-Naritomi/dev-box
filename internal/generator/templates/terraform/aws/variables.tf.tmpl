variable "region" {
  description = "AWS region to deploy resources"
  type        = string
  default     = "ap-northeast-1"
}

variable "name_prefix" {
  description = "Prefix for resource names; change it to run several environments side by side"
  type        = string
  default     = "devbox"

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{1,20}$", var.name_prefix))
    error_message = "name_prefix must start with a lowercase letter and contain only lowercase letters, digits and hyphens (2-21 characters)."
  }
}

variable "instance_type" {
  description = "EC2 instance type, sized for the selected stack"
  type        = string
  default     = "{{ .InstanceType }}"
}

variable "key_name" {
  description = "Name of the SSH key pair to use for EC2 access"
  type        = string
}

variable "enable_public_ip" {
  description = "Whether to associate a public IPv4 address with the instance"
  type        = bool
  default     = false
}

variable "allowed_ssh_cidrs" {
  description = "CIDR blocks allowed to connect over SSH; empty disables public SSH"
  type        = list(string)
  default     = []
}

variable "enable_public_web" {
  description = "Whether to expose HTTP and HTTPS publicly"
  type        = bool
  default     = false
}

variable "allowed_web_cidrs" {
  description = "CIDR blocks allowed to access HTTP and HTTPS"
  type        = list(string)
  default     = []
}

variable "allowed_egress_cidrs" {
  description = "CIDR blocks allowed for outbound traffic; empty disables internet egress"
  type        = list(string)
  default     = []
}
